{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "asset-workshop-skin"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "basePreset": {
      "type": "string",
      "enum": [
        "comic",
        "fresh",
        "paper"
      ]
    },
    "tokens": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "canvas",
          "surface",
          "raised",
          "text",
          "muted",
          "border",
          "accent",
          "cyan",
          "violet",
          "onAccent",
          "success",
          "warning",
          "error",
          "focus",
          "shadow"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      }
    },
    "resources": {
      "default": [],
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "scale": {
            "default": 1,
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "atlasRegion": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sourceWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sourceHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height",
              "sourceWidth",
              "sourceHeight"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "author": {
                "type": "string",
                "maxLength": 200
              },
              "license": {
                "type": "string",
                "maxLength": 500
              },
              "pageUrl": {
                "type": "string",
                "maxLength": 2000
              },
              "assetId": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "author",
              "license"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "width",
          "height",
          "scale"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "default": [],
      "maxItems": 2304,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "primary-button",
              "secondary-button",
              "danger-button",
              "icon-button",
              "nav-item",
              "tabs",
              "segmented",
              "text-field",
              "search-field",
              "select-field",
              "text-area",
              "checkbox",
              "radio",
              "range",
              "badge",
              "tag",
              "status-stamp",
              "progress",
              "hint",
              "stat-card",
              "section-title",
              "panel",
              "toolbar",
              "asset-card",
              "group-card",
              "texture-slot",
              "menu",
              "tooltip",
              "dialog",
              "toast",
              "loading-state",
              "empty-state"
            ]
          },
          "slot": {
            "type": "string",
            "enum": [
              "background",
              "border",
              "mark",
              "icon",
              "decoration"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "default",
              "hover",
              "pressed",
              "focus",
              "selected",
              "partial",
              "disabled",
              "loading",
              "error",
              "warning",
              "success",
              "open",
              "empty",
              "complete",
              "working",
              "removable",
              "long",
              "paper"
            ]
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "fit": {
            "type": "string",
            "enum": [
              "nine-slice",
              "stretch",
              "contain",
              "tile"
            ]
          },
          "slices": {
            "type": "object",
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "right": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "bottom": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "left": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              }
            },
            "required": [
              "top",
              "right",
              "bottom",
              "left"
            ],
            "additionalProperties": false
          },
          "contentInsets": {
            "type": "object",
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "right": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "bottom": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "left": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              }
            },
            "required": [
              "top",
              "right",
              "bottom",
              "left"
            ],
            "additionalProperties": false
          },
          "bleed": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 8
          }
        },
        "required": [
          "component",
          "slot",
          "state",
          "resource",
          "fit",
          "bleed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "basePreset",
    "tokens",
    "resources",
    "bindings"
  ],
  "additionalProperties": false
}